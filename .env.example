# Bu dosyayı .env adıyla kopyala ve kendi anahtarlarını yaz:  cp .env.example .env
# Sadece kullanacağın modelin anahtarı yeterli (varsayılan model gpt-6-luna → OPENAI_API_KEY)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Ollama (embedding + yerel modeller). Docker içinden çalışırken compose dosyası bunu kendisi ayarlar.
OLLAMA_URL=http://localhost:11434
